# ── Configuración de opencode para pipelines ──
# Copia este archivo como .env y completa los valores

# Modelo de IA a usar
OPENCODE_MODEL=deepseek/deepseek-v4-flash

# Timeout por pipeline (segundos)
PIPELINE_TIMEOUT=3600

# API key (alternativa a ~/.local/share/opencode/auth.json)
OPENCODE_API_KEY=sk-tu-key-aqui

# Rutas (relativas a scripts/)
PIPELINE_PROMPTS_DIR=../../2.5-prompts
PIPELINE_REQUISITOS_DIR=../../2-requisitos

# Ruta del binario opencode (por defecto: opencode en PATH)
# OPENCODE_BIN=opencode

# API Base alternativa
# OPENAI_API_BASE=https://openbase.example.com/v1
